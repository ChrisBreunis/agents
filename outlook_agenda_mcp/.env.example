# Application (client) ID van je app-registratie in Entra ID.
# Te vinden via entra.microsoft.com > App-registraties > je app > Overzicht.
# Dit is geen geheim, maar zet .env toch nooit in git.
OUTLOOK_CLIENT_ID=

# Directory (tenant) ID, op dezelfde overzichtspagina. Je mag hier ook je
# domeinnaam invullen, of 'organizations' als je met een werkaccount inlogt.
OUTLOOK_TENANT_ID=

# Tijdzone voor tijden zonder expliciete zone, en voor wat Graph teruggeeft.
OUTLOOK_TIMEZONE=Europe/Amsterdam

# Zet dit op true als je ook agenda's van anderen wilt kunnen bewerken waar je
# rechten op hebt gekregen. Vraagt dan ook Calendars.ReadWrite.Shared aan, dus
# je moet daarna opnieuw inloggen met login.py.
OUTLOOK_GEDEELDE_AGENDAS=false

# Zelden nodig.
OUTLOOK_GRAPH_BASE=https://graph.microsoft.com/v1.0
OUTLOOK_TIMEOUT=30
