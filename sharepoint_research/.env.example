# ── Kopieer dit bestand naar .env en vul je eigen waarden in ──────────────
# .env staat in .gitignore en wordt NOOIT gecommit.

# Tenant-id van je organisatie (GUID) of de domeinnaam, bv. organisatie.onmicrosoft.com
SP_TENANT_ID=

# Client-id (Application ID) van de Azure AD app-registratie (public client / device code).
# Zie README.md, stap 1, hoe je deze in 5 minuten aanmaakt.
SP_CLIENT_ID=

# Volledige URL van de SharePoint-site waar de bibliotheek op staat.
# Voorbeeld: https://organisatie.sharepoint.com/sites/Raadsonderzoek
SP_SITE_URL=

# Naam van de documentbibliotheek precies zoals in SharePoint.
# Vaak "Documents", "Documenten" of "Gedeelde documenten".
# Laat leeg om de standaard-documentbibliotheek van de site te gebruiken.
SP_LIBRARY_NAME=

# Map waarin gedownloade bestanden, geëxtraheerde tekst en rapport komen.
OUTPUT_DIR=output
