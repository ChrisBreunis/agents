# ── Kopieer dit bestand naar .env en vul in ──────────────────────────────
# .env staat in .gitignore en wordt NOOIT gecommit.

# ===== LOKALE FLOW (aanbevolen) ==========================================

# Jouw eigen Anthropic API-sleutel voor de inhoudelijke duiding (stap 3).
# Zonder deze sleutel draait alleen het feitenrapport.
ANTHROPIC_API_KEY=

# Map waarin jij je documenten zet (standaard: input_documenten/).
INPUT_DIR=

# Map waarin tekst, bronregister en rapportage komen (standaard: output/).
OUTPUT_DIR=

# Claude-model voor de duiding (standaard: claude-opus-4-8).
LLM_MODEL=

# ===== OPTIONEEL: SharePoint/Graph-route =================================
# Alleen invullen als je tóch via Microsoft Graph wilt koppelen i.p.v. lokaal.
SP_TENANT_ID=
SP_CLIENT_ID=
SP_SITE_URL=
SP_LIBRARY_NAME=
