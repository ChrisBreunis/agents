# API-sleutel uit e-Boekhouden: Beheer > Koppelingen > API > REST API
# > Nieuwe API-sleutel aanmaken. Deze sleutel geeft toegang tot je administratie:
# bewaar hem alleen lokaal en zet .env nooit in git.
EBOEKHOUDEN_API_TOKEN=

# Naam waaronder deze koppeling in e-Boekhouden wordt gelogd.
EBOEKHOUDEN_SOURCE=claude-mcp

# Vaste keuzes, zodat je ze niet elke factuur hoeft op te geven.
# Vraag de id's op met list_invoice_templates en list_ledgers.
EBOEKHOUDEN_DEFAULT_TEMPLATE_ID=
EBOEKHOUDEN_DEFAULT_LEDGER_ID=
EBOEKHOUDEN_DEFAULT_VAT_CODE=HOOG_VERK_21

# Facturen direct naar de klant mailen. Standaard uit: eerst zelf controleren.
EBOEKHOUDEN_ALLOW_EMAIL=false

# Zelden nodig.
EBOEKHOUDEN_API_BASE=https://api.e-boekhouden.nl
EBOEKHOUDEN_TIMEOUT=30
